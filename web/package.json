{
  "name": "spark-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "nuxt build",
    "generate": "nuxt generate",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "api:gen": "openapi-typescript ../docs/openapi.yaml --output app/api/generated/schema.d.ts --empty-objects-unknown --array-length",
    "api:check": "npm run api:gen && git diff --exit-code -- app/api/generated/schema.d.ts && ! git status --porcelain --ignored -- app/api/generated/schema.d.ts | grep -vE '^[A-Z]  ' | grep -q . || (echo '契约一致性校验失败：app/api/generated/schema.d.ts 与 docs/openapi.yaml 不一致（含未跟踪/被忽略的生成物），请先运行 npm run api:gen 并将生成物提交入库'; exit 1)"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.124",
    "@nuxt/ui": "4.10.0",
    "nuxt": "4.5.2",
    "tailwindcss": "4.3.3",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "eslint": "10.9.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vue-tsc": "3.3.10"
  }
}
