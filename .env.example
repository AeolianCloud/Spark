# 环境变量示例模板：复制为 .env.local 并按需填写（.env.local 已被 .gitignore 忽略，不会提交）
# 自动加载：go run ./cmd/server 启动时自动读取仓库根目录的 .env.local，无需手动 source
# 优先级链：默认值 < config/config.yaml < .env.local < 进程环境变量（显式设置的进程环境变量优先，不被 .env.local 覆盖）
# 这些变量会覆盖 config/config.yaml 中对应的配置项（见 config/config.go applyEnv）

# HTTP 服务监听端口，默认 8080
SPARK_SERVER_PORT=8080

# PostgreSQL 连接串，必须替换为真实凭据
SPARK_DATABASE_DSN=postgres://spark:change-me@localhost:5432/spark?sslmode=disable

# AES-256-GCM 加密密钥（base64 编码的 32 字节），生产环境必须替换
# 生成方式：openssl rand -base64 32
SPARK_CRYPTO_ENCRYPTION_KEY=

# JWT 签名密钥（HMAC-SHA256），必填且至少 32 字符，缺失或过短拒绝启动
# 生成方式：openssl rand -base64 32
SPARK_AUTH_JWT_SECRET=

# 日志级别：debug / info / warn / error
SPARK_LOG_LEVEL=info

# 镜像下载源域名白名单（逗号分隔），download_url 的 host 必须命中才受理下载；
# 留空（= 后无内容）语义为拒绝所有下载；不设置该变量则用 config.yaml 的内置默认值
SPARK_IMAGES_DOWNLOAD_HOST_ALLOWLIST=cloud.debian.org,cloud-images.ubuntu.com,cloud.centos.org,download.cirros-cloud.net,cloud-images.rockylinux.org
