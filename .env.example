# 环境变量示例模板：复制为 .env.local 并按需填写（.env.local 已被 .gitignore 忽略，不会提交）
# 加载方式：set -a; source .env.local; set +a
# 这些变量会覆盖 config/config.yaml 中对应的配置项（见 config/config.go applyEnv）

# HTTP 服务监听端口，默认 8080
SPARK_SERVER_PORT=8080

# PostgreSQL 连接串，必须替换为真实凭据
SPARK_DATABASE_DSN=postgres://spark:change-me@localhost:5432/spark?sslmode=disable

# AES-256-GCM 加密密钥（base64 编码的 32 字节），生产环境必须替换
# 生成方式：openssl rand -base64 32
SPARK_CRYPTO_ENCRYPTION_KEY=

# 日志级别：debug / info / warn / error
SPARK_LOG_LEVEL=info
